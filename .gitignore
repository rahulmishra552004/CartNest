# Load-test data; the scripts and docs in locust_loadtest/ are tracked.
# The first three match anywhere on purpose: account files hold passwords, and
# LOADTEST_DATA_PATH can point Locust at a copy outside locust_loadtest/
loadtest_data.json
loadtest-audit*.json
.loadtest-restore-*
locust_loadtest/media.loadtest/
locust_loadtest/loadtest-postgres-baseline.dump
locust_loadtest/loadtest-postgres-baseline.dump.tmp

# Celery scheduler runtime state
celerybeat-schedule*

# Editors and operating systems
.vscode/
.idea/
.DS_Store

# Generated load-test reports
locust_report/

# Personal study notes, kept on disk but not in the repository
notes/

staticfiles/
